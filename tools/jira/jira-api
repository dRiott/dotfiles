#!/usr/local/bin/python3
"""Low-level Jira REST API helper. Used by other jira-* tools for operations
that acli doesn't support (e.g. setting parent/epic).

Usage:
  jira-api GET  /rest/api/3/issue/DDR-1234?fields=summary
  jira-api PUT  /rest/api/3/issue/DDR-1234 '{"fields":{"parent":{"key":"DDR-5678"}}}'
  jira-api POST /rest/api/3/issue '{"fields":{...}}'
"""
import base64, json, subprocess, sys

SITE = "cyberhaven.atlassian.net"
EMAIL = "david.riott@cyberhaven.com"
CURL = "/usr/bin/curl"
SECURITY = "/usr/bin/security"


def get_token():
    raw = subprocess.check_output(
        [SECURITY, "find-generic-password", "-s", "acli", "-w"],
        text=True,
    ).strip()
    raw = raw.removeprefix("go-keyring-base64:")
    return base64.b64decode(raw).decode()


def main():
    if len(sys.argv) < 3:
        print("Usage: jira-api <GET|PUT|POST|DELETE> <path> [json-body]", file=sys.stderr)
        sys.exit(1)

    method, path = sys.argv[1], sys.argv[2]
    body = sys.argv[3] if len(sys.argv) > 3 else None

    token = get_token()

    cmd = [
        CURL, "-s", "-w", "\n%{http_code}",
        "-X", method,
        "-H", "Content-Type: application/json",
        "-u", f"{EMAIL}:{token}",
    ]
    if body:
        cmd += ["-d", body]
    cmd.append(f"https://{SITE}{path}")

    result = subprocess.run(cmd, capture_output=True, text=True)
    lines = result.stdout.rstrip("\n").rsplit("\n", 1)
    response = lines[0] if len(lines) > 1 else ""
    code = int(lines[-1]) if lines[-1].isdigit() else 0

    if 200 <= code < 300:
        if response:
            print(response)
    else:
        print(f"Error: HTTP {code}", file=sys.stderr)
        if response:
            print(response, file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
