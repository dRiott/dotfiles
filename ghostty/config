# https://github.com/edheltzel/dotfiles/blob/master/config/.config/ghostty/config

# --- Shell Configuration ---
command = /bin/zsh --login

# --- Appearance (Your Current Style) ---
theme = Catppuccin Mocha
font-family = "JetBrains Mono"
font-size = 22
adjust-cell-height = 15%
# Changed to 'tabs' so you can see Claude session names
macos-titlebar-style = tabs
# Open new tabs at the end, not next to the current one
window-new-tab-position = end
window-padding-x = 10
window-padding-y = 10
background-opacity = 0.95
background-blur-radius = 50

# --- Claude Code Optimization ---
# Massive scrollback for long AI conversations
scrollback-limit = 10000000
copy-on-select = clipboard
clipboard-read = allow
clipboard-write = allow

keybind = super+k>p=toggle_command_palette

# Splitting for multiple sessions
keybind = super+k>h=new_split:left
keybind = super+k>l=new_split:right
keybind = super+k>j=new_split:down
keybind = super+k>z=toggle_split_zoom
keybind = super+k>equal=equalize_splits
#
# Fast pane switching with Cmd + Arrow Keys
keybind = super+left=goto_split:left
keybind = super+right=goto_split:right
keybind = super+up=goto_split:up
keybind = super+down=goto_split:down

# Tabs: Cmd+T new, Cmd+1..9 switch, Cmd+W close — all built-in

# Quick Config Reload
keybind = super+ctrl+alt+,=reload_config

split-divider-color = #ff8080
unfocused-split-opacity = 0.3
